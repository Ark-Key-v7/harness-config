+      if (cmd === "seat") {
+        const validSeats = ["scout", "planner", "worker", "reviewer"];
+        const arg = (args[0] ?? "").toLowerCase().trim();
+        const statePath = join(homedir(), ".pi", "agent", "seat-state.json");
+        const profilesDir = process.env.RIG_PROFILES_DIR ? process.env.RIG_PROFILES_DIR : join(homedir(), ".pi", "agent", "templates", "agents", "profiles");
+        const sendSeatText = (text) => this.conn.sessionUpdate({
+          sessionId: session.sessionId,
+          update: {
+            sessionUpdate: "agent_message_chunk",
+            content: { type: "text", text }
+          }
+        }).then(() => ({ stopReason: "end_turn" }));
+        let seatState = {};
+        try {
+          seatState = JSON.parse(readFileSync(statePath, "utf8"));
+        } catch {
+        }
+        const seatSummary = (seat) => {
+          try {
+            const content = readFileSync(join(profilesDir, `${seat}.md`), "utf8");
+            const m = content.match(/^#\s*PROFILE:\s*\S+\s*\((.+)\)\s*$/m);
+            return m ? m[1] : "(no `# PROFILE:` summary heading found)";
+          } catch {
+            return "(profile MISSING — pull the rig clone)";
+          }
+        };
+        if (arg === "list") {
+          const activeSeat = validSeats.includes(seatState[session.cwd]) ? seatState[session.cwd] : null;
+          const lines = validSeats.map((s) => `${s === activeSeat ? "●" : "○"} ${s} — ${seatSummary(s)}`);
+          return sendSeatText(`Seats (● = active):\n${lines.join("\n")}\n\nSwitch: /seat <name> · Peek full profile: /seat show <name> · Clear: /seat off`);
+        }
+        if (arg === "show") {
+          const target = (args[1] ?? "").toLowerCase().trim();
+          if (!validSeats.includes(target)) {
+            return sendSeatText(`Usage: /seat show <${validSeats.join("|")}>. State unchanged.`);
+          }
+          const profileFile = join(profilesDir, `${target}.md`);
+          let content;
+          try {
+            content = readFileSync(profileFile, "utf8");
+          } catch {
+            return sendSeatText(`Profile for seat "${target}" not found at ${profileFile} — pull the rig clone (git -C ~/.pi/agent pull --ff-only).`);
+          }
+          if (Buffer.byteLength(content) > 16384) {
+            content = Buffer.from(content).subarray(0, 16384).toString("utf8") + "\n\n[profile truncated — exceeded 16KB display cap]";
+          }
+          return sendSeatText(`Profile: ${target} (${profileFile})\n\n${content}`);
+        }
+        if (arg && arg !== "off" && !validSeats.includes(arg)) {
+          return sendSeatText(`Unknown seat "${arg}". Usage: /seat ${validSeats.join("|")}|off|list|show <seat>`);
+        }
+        let text = "";
+        if (!arg || arg === "off") {
+          delete seatState[session.cwd];
+          text = `Seat cleared for ${session.cwd}.`;
+        } else {
+          const profileFile = join(profilesDir, `${arg}.md`);
+          try {
+            readFileSync(profileFile, "utf8");
+            seatState[session.cwd] = arg;
+            text = `Seat set to ${arg} for ${session.cwd}.`;
+          } catch {
+            text = `Profile for seat "${arg}" not found at ${profileFile}. State unchanged. Pull the rig clone (git -C ~/.pi/agent pull --ff-only).`;
+          }
+        }
+        try {
+          mkdirSync(dirname(statePath), { recursive: true });
+          writeFileSync(statePath, JSON.stringify(seatState, null, 2) + "\n", "utf8");
+          if (!text.includes("not found")) {
+            text += " The new seat will take effect on the next agent session.";
+          }
+        } catch (e) {
+          text += ` Failed to write seat state: ${String(e?.message ?? e)}`;
+        }
+        return sendSeatText(text);
+      }
     }
     const result = await session.prompt(message, images);
